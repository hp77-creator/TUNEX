# TUNEX Environment Variables
# Copy this file to .env and fill in your values

# Django Settings
DEBUG=True
SECRET_KEY=django-insecure-tunex-development-key-change-in-production-123456789
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Spotify Developer API Credentials
# Create an application at https://developer.spotify.com/dashboard
# Add Redirect URI: http://127.0.0.1:8000/spotify/callback/
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback/
